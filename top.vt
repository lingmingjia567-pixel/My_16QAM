`timescale 10 ns/ 10 ns
module top_vlg_tst();

// test vector input registers
reg carrier_clk;
reg reset_n;
reg signal_clk;
// wires                                               
wire in_data;
wire out_data;

// assign statements (if any)                          
top i1 (
// port map - connection between master ports and signals/registers   
	.carrier_clk(carrier_clk),
	.in_data(in_data),
	.out_data(out_data),
	.reset_n(reset_n),
	.signal_clk(signal_clk)
);

initial                                                
begin                                                  
	reset_n = 1'b0;
	signal_clk = 1'b0;
	carrier_clk = 1'b0;
	#250 reset_n = 1'b1;
end                                                    

always                                                 
begin                                                  
	 #50.0 carrier_clk = ~carrier_clk;  //模拟 PLL 输出的 10MHz 采样时钟 (周期 100ns)
end    

always
begin
	#100.0 signal_clk = ~signal_clk;	//模拟 PLL 输出的 5MHz 比特时钟 (周期 200ns)
end


// =========================================================
// 🌟 全局状态变量提前声明 (修复先使用后声明的编译报错)
// =========================================================
reg start_calc = 0;


// =========================================================
// 🔋 【终极版】自动能量探测器：精准统计纯净信号的真实 RMS
// =========================================================
//real sum_squares = 0.0;
//integer rms_samples = 0;
//real fpga_true_rms = 0.0;

//always @(posedge carrier_clk) begin
//    if (reset_n) begin
//        // 🌟 严格等 300ms 垃圾时间结束，只统计稳态信号的能量！
//        if (start_calc) begin
            // 🚨 核心修复：先用 $itor 转成浮点数再乘，彻底解决 16位 乘法溢出问题！
 //           sum_squares = sum_squares + ($itor($signed(i1.mod_data)) * $itor($signed(i1.mod_data)));
 //           rms_samples = rms_samples + 1;
 //       end
//    end
//end
// =========================================================
// =========================================================


// =========================================================
// 🏆 毕设最终汇报版：双轨计数与完美对齐
// =========================================================

parameter DELAY_BITS = 55; 
parameter SKIP_TIME = 30000000; // 300ms 垃圾时间

// 🌟 双轨计数器
integer global_bits = 0; // 从头开始的总比特数
integer calc_bits = 0;   // 收敛后用于计算误码的有效比特数
integer error_bits = 0;
real current_ber = 0.0;

// 1. 构造“时间机器” (移位寄存器)
reg [127:0] delay_line = 128'b0;

always @(posedge signal_clk) begin
    if (!reset_n)
        delay_line <= 128'b0;
    else
        delay_line <= {delay_line[126:0], in_data};
end

wire in_data_aligned = delay_line[DELAY_BITS - 1];

// 2. 倒计时器：跳过前期的混乱状态
initial begin
    #SKIP_TIME;
    start_calc = 1;
    $display("==================================================");
    $display("  System Converged! BER calculation STARTED!      ");
    $display("==================================================");
end

// 3. 终极双轨法官
always @(negedge signal_clk) begin 
    if (reset_n) begin
        // 只要没复位，全局计数器永远在跑
        global_bits = global_bits + 1; 
        
        // 当垃圾时间结束，计分计数器才开始工作
        if (start_calc) begin
            calc_bits = calc_bits + 1;
            
            // 抓错码！
            if (in_data_aligned !== out_data) begin
                error_bits = error_bits + 1;
            end
            
            // 🟢 实时打卡：每 10000 个有效比特汇报一次
            if (calc_bits % 10000 == 0) begin
                current_ber = (error_bits * 1.0) / calc_bits;
                $display("Global Bits: %0d | Valid Bits: %0d | Errors: %0d | BER: %e", 
                         global_bits, calc_bits, error_bits, current_ber);
            end
            
            // 🔴 终极结算：有效比特跑满 100,000 个，强制停车！
            if (calc_bits == 100000) begin
                current_ber = (error_bits * 1.0) / calc_bits;
                
                $display("\n==================================================");
                $display("             FINAL BER REPORT                     ");
                $display("==================================================");
                $display("Total Global Bits : %0d (System lifetime)", global_bits);
                $display("Total Valid Bits  : %0d (Evaluated bits)", calc_bits);
                $display("Total Error Bits  : %0d", error_bits);
                $display("Final BER         : %e", current_ber);
                $display("==================================================");
                
					 //打印FPGA稳态有效值
              //  fpga_true_rms = $sqrt(sum_squares / rms_samples);
              //  $display("\n==================================================");
              //  $display("      TX PURE SIGNAL ENERGY STATISTICS (RMS)      ");
              //  $display("==================================================");
               // $display("Steady-state Sample Count : %d", rms_samples);
              //  $display("FPGA True RMS Value       : %f", fpga_true_rms);
              //  $display("==================================================\n");
                
                $stop; 
            end
        end
    end
end

// =========================================================
// 📸 星座图录像机：将 FPGA 内部的 I/Q 数据导出给 MATLAB
// =========================================================

integer file_iq;

initial begin
    // 自动在你的 modelsim 目录下创建一个 txt 文件存放 I/Q 数据
    file_iq = $fopen("C:/Users/21503/Desktop/My_16QAM-main/simulation/modelsim/fpga_iq_data.txt", "w");
    if (!file_iq) begin
        $display("Error: Could not open file!");
    end
end

always @(posedge carrier_clk) begin
    if (reset_n) begin
        // 只有当定时环路说“现在是最佳采样点”时，才按下快门记录
        if (i1.demod.symbol_strobe) begin
            // 把解旋转后的最终 I 和 Q 数据以十进制写入文件，中间加个空格
            $fwrite(file_iq, "%d %d %d %d\n", 
        $signed(i1.demod.fir_i), $signed(i1.demod.fir_q),     // 前两个数：同步前 (满天星)
        $signed(i1.demod.final_i), $signed(i1.demod.final_q)  // 后两个数：同步后 (完美16点)
);
        end
    end
end
endmodule