// fill out necessary details.                                                  
// *****************************************************************************
// Generated on "12/19/2020 00:33:47"
                                                                                
// Verilog Test Bench template for design : top
// 
// Simulation tool : ModelSim-Altera (Verilog)
// 

`timescale 10 ns/ 10 ns
module top_vlg_tst();
// constants                                           
// general purpose registers
// test vector input registers
reg carrier_clk;
reg reset_n;
reg signal_clk;
// wires                                               
wire in_data;
wire out_data;

// assign statements (if any)                          
top i1 (
// port map - connection between master ports and signals/registers   
	.carrier_clk(carrier_clk),
	.in_data(in_data),
	.out_data(out_data),
	.reset_n(reset_n),
	.signal_clk(signal_clk)
);

initial                                                
begin                                                  
// code that executes only once                        
// insert code here --> begin                          
                                                       
// --> end                                             
	reset_n = 1'b0;
	signal_clk = 1'b0;
	carrier_clk = 1'b0;
	#250 reset_n = 1'b1;
end                                                    

always                                                 
// optional sensitivity list                           
// @(event1 or event2 or .... eventn)                  
begin                                                  
// code executes for every event on sensitivity list   
// insert code here --> begin                          
	 #50.0 carrier_clk = ~carrier_clk;  //模拟 PLL 输出的 10MHz 采样时钟 (周期 100ns)
                                                       
// --> end                                             
end    

always
begin
	#100.0 signal_clk = ~signal_clk;	//模拟 PLL 输出的 5MHz 比特时钟 (周期 200ns)
end

// =========================================================
// 🏆 终极绝杀：自动误码率 (BER) 统计模块 
// =========================================================

// 🔴 核心密码 1：延迟对齐 (需要你动态校准)
// in_data 和 out_data 之间差了多少个比特周期？请看波形填入！
parameter DELAY_BITS = 53; 

// 🔴 核心密码 2：跳过垃圾时间
// timescale 是 10ns，如果想跳过 300us，就是 300,000ns = 30000 个 timescale 单位
parameter SKIP_TIME = 11700; 

// 统计用内部寄存器
integer total_bits = 0;
integer error_bits = 0;
real current_ber = 0.0;
reg start_calc = 0;

// 1. 构造“时间机器” (移位寄存器)，把 in_data 强行往后拖延
reg [127:0] delay_line = 128'b0;

always @(posedge signal_clk) begin
    if (!reset_n)
        delay_line <= 128'b0;
    else
        delay_line <= {delay_line[126:0], in_data};
end

// 这就是延迟了指定拍数、和 out_data 处于同一物理时间的“完美对齐输入”
wire in_data_aligned = delay_line[DELAY_BITS - 1];

// 2. 倒计时器：跳过前期的混乱状态
initial begin
    #SKIP_TIME;
    start_calc = 1;
    $display("========================================");
    $display("Trash time ended. BER calculation STARTED!");
    $display("========================================");
end

// 3. 逐比特比对法官 (带实时进度条 + 终极结算)
always @(negedge signal_clk) begin 
    if (start_calc) begin
        total_bits = total_bits + 1;
        
        // 抓到内鬼！
        if (in_data_aligned !== out_data) begin
            error_bits = error_bits + 1;
            // 发现误码时打印
            $display("Error! Time: %0t | Expected: %b | Got: %b", 
                     $time, in_data_aligned, out_data);
        end
        
        // 🟢 进度条恢复：每 1000 个比特汇报一次实时战况！
        if (total_bits % 1000 == 0) begin
            current_ber = (error_bits * 1.0) / total_bits;
            $display("Progress -> Total Bits: %0d | Errors: %0d | BER: %e", 
                     total_bits, error_bits, current_ber);
        end
        
        // 🔴 终极结算：200,000 比特跑完，做最终汇报并停车！
        if (total_bits == 200000) begin
            current_ber = (error_bits * 1.0) / total_bits;
            
            $display("\n========================================");
            $display("           FINAL BER REPORT             ");
            $display("========================================");
            $display("Total Bits : %0d", total_bits);
            $display("Error Bits : %0d", error_bits);
            $display("Final BER  : %e", current_ber);
            $display("========================================\n");
            
            // 跑完了自动踩刹车，停止仿真！
            $stop; 
        end
    end
end
endmodule